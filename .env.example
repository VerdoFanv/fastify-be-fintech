NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# PostgreSQL (local app / docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastify_be_fintech
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastify_be_fintech?schema=public

# JWT (min 16 chars)
JWT_SECRET=change-me-to-a-long-secret
JWT_EXPIRES_IN=7d
API_KEY=change-me-to-a-long-api-key

# S3 / MinIO (leave S3_ENDPOINT empty for real AWS)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=fintech-uploads
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=5242880

# Redis (rate-limit). Empty = in-memory rate limit in development only.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Kafka (KRaft). Empty = sync webhook fallback in development/test.
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_CLIENT_ID=fintech-api
KAFKA_GROUP_ID=fintech-webhook-workers

# OpenTelemetry (set true when observability profile is up)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fastify-be-fintech
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Demo seed users (after npm run db:seed):
# admin@example.com / test1234!
# customer@example.com / test1234!
